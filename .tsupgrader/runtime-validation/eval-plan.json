{
  "projectType": "webapp",
  "assertions": [
    {
      "name": "root-build",
      "kind": "process",
      "command": "npm",
      "args": ["run", "build"],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 300
    },
    {
      "name": "frontend-typecheck",
      "kind": "process",
      "command": "npx",
      "args": ["tsc", "--noEmit"],
      "cwd": "frontend",
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "root-typecheck",
      "kind": "process",
      "command": "npm",
      "args": ["run", "typecheck"],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "tests-pass",
      "kind": "process",
      "command": "node",
      "args": ["--import", "tsx", "--test", "backend/tests/security_controls.test.ts"],
      "verificationMethod": "test-results",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "frontend-serves-home",
      "kind": "http-probe",
      "startCommand": "npm",
      "startArgs": ["run", "dev", "--", "--host", "127.0.0.1", "--strictPort", "--port", "5173"],
      "cwd": "frontend",
      "url": "http://127.0.0.1:5173/",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 120
    }
  ]
}
