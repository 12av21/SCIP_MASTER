# SCIP - Smart Community Intelligence Platform
# Environment Configuration Template
# Copy this file to .env and fill in your values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MongoDB connection string
# Set to a development or test database only. Do not copy production credentials here.
MONGODB_URI=""

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Set to a generated secret of at least 32 bytes; blank intentionally fails closed.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_IN=30d

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
VITE_API_BASE=http://localhost:3000/api

# =============================================================================
# OPTIONAL: EXTERNAL SERVICES
# =============================================================================
# AI/ML Engine Service (Python microservice if used)
AI_SERVICE_URL="http://localhost:8000"

# OpenAI API Key for LLM agent (optional)
# OPENAI_API_KEY=sk-...

# Google Gemini API Key (optional)
GEMINI_API_KEY=""

# Email service (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...

# File upload (optional)
# UPLOAD_MAX_SIZE=10485760
# UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf

# =============================================================================
# PRODUCTION OVERRIDES (set in production environment)
# =============================================================================
# NODE_ENV=production
# FRONTEND_URL="https://your-domain.com"
# MONGODB_URI="mongodb+srv://..."
# JWT_SECRET="<generated-64-char-secret>"
# JWT_REFRESH_SECRET="<generated-64-char-secret>"
